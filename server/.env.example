# Бэкенд. Скопируйте в server/.env при необходимости.

# По умолчанию — SQLite рядом с сервером (никакой установки СУБД не нужно):
DATABASE_URL=sqlite:///./fin_reports.db

# MySQL 8 (цель Фазы 4) — раскомментируйте и заполните; поставьте pymysql+cryptography:
# DATABASE_URL=mysql+pymysql://fin:fin@127.0.0.1:3306/fin_reports

# Источники CORS через запятую. «*» — удобно для теста в локальной сети.
CORS_ORIGINS=*
