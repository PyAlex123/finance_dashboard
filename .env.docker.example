# Переменные для docker compose (Фаза 5). Скопируйте в .env.docker и заполните.
# Запуск: docker compose --env-file .env.docker up -d --build

# Порт, на котором сайт будет доступен по HTTP (без TLS)
WEB_PORT=8080

# Базовый URL API для сборки фронта. "/" — тот же origin (nginx проксирует /api).
# Меняйте только для кросс-доменного размещения фронта и API.
VITE_API_URL=/

# MySQL
DB_PASSWORD=finpass
DB_ROOT_PASSWORD=rootpass

# CORS на бэкенде. При одном origin (через nginx) можно оставить *.
CORS_ORIGINS=*

# --- Telegram Web App (необязательно; нужно для входа через Telegram) ---
# Токен бота от @BotFather. Пусто — вход через Telegram выключен, работает
# обычный вход по имени.
TELEGRAM_BOT_TOKEN=
# Секрет для подписи JWT. В проде обязательно замените на длинную случайную строку.
JWT_SECRET=change-me-in-production

# --- TLS через Caddy (профиль tls) ---
# Реальный домен, указывающий на сервер. Нужен для docker compose --profile tls
DOMAIN=localhost
