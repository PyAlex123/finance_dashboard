# Переменные для docker compose (деплой на подпуть). Скопируйте в .env.docker.
# Запуск: docker compose --env-file .env.docker up -d --build   (БЕЗ флага -p!)

# Где живёт приложение. Вариант по умолчанию — КОРЕНЬ отдельного домена
# (https://finlo.uz/): BASE_PATH пустой, база ассетов и API — «/».
# VITE_API_URL пустым не оставлять: пустое значение = локальный режим (IndexedDB).
BASE_PATH=
VITE_BASE=/
VITE_API_URL=/

# Вариант «на подпути» (как было на grammerce.io/dashboards):
# BASE_PATH=/dashboards
# VITE_BASE=/dashboards/
# VITE_API_URL=/dashboards

# Локальный порт контейнера (nginx → сюда). Наружу не открыт (bind 127.0.0.1).
APP_PORT=8090

# Хранилище — SQLite в томе app_data (данные переживают перезапуск).
DATABASE_URL=sqlite:////data/fin_reports.db

# CORS: всё под одним origin (grammerce.io), можно оставить *.
CORS_ORIGINS=*

# --- Telegram Web App ---
# Токен бота от @BotFather (пусто = вход через Telegram выключен).
TELEGRAM_BOT_TOKEN=
# Имя бота без «@» — обычно определяется само (getMe). Задавайте, только если
# контейнер не ходит в api.telegram.org.
# TELEGRAM_BOT_USERNAME=financePro

# --- Вход через Google (кнопка на /login) ---
# Client ID веб-приложения из Google Cloud → APIs & Services → Credentials.
# Пусто — кнопка Google неактивна. Client secret не нужен. Инструкция — в DEPLOY.md.
GOOGLE_CLIENT_ID=
# Секрет подписи JWT — в проде ОБЯЗАТЕЛЬНО заменить на длинную случайную строку,
# напр.: openssl rand -hex 32
JWT_SECRET=change-me-in-production
# Публичный URL Web App для кнопок бота (/start и левое меню «Кабинет»).
WEBAPP_URL=https://finlo.uz/
# Админы — Telegram id через запятую (видят список пользователей). Пусто — админов нет.
# Свой id виден в приложении (экран выбора модуля). Пример: ADMIN_TG_IDS=12345,67890
ADMIN_TG_IDS=
